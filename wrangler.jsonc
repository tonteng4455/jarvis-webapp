{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jarvis-webapp",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    { "binding": "BOT_WORKER", "service": "line-bot-engine" }
  ],
  "vars": {
    "SUPABASE_URL": "https://ujyvvykxakgtbpwdnsnd.supabase.co",
    "LINE_LOGIN_CHANNEL_ID": "2011286846",
    "LINE_LOGIN_REDIRECT_URI": "https://jarvis-webapp.tonteng4455.workers.dev/api/auth/callback",
    "USER_CAP": "200",
    "PREMIUM_CAP_BONUS_SLOTS": "5",
    "WORKER_URL": "https://line-bot-engine.tonteng4455.workers.dev",
    "NEXT_PUBLIC_LIFF_ID": "2011286846-CKLapBCE",
    "LIFF_ID": "2011286846-CKLapBCE"
  }
}
