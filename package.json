{
  "name": "jarvis-webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "check:jarvis": "node tools/check-instance.mjs wrangler.jsonc",
    "check:friday": "node tools/check-instance.mjs wrangler.friday.jsonc",
    "deploy:jarvis": "node tools/check-instance.mjs wrangler.jsonc && opennextjs-cloudflare build && wrangler deploy",
    "deploy:friday": "node tools/check-instance.mjs wrangler.friday.jsonc && NEXT_PUBLIC_BRAND_NAME=Friday opennextjs-cloudflare build && wrangler deploy --config wrangler.friday.jsonc"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "jose": "^5.6.3",
    "next": "^15.5.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "wrangler": "^4.152.0"
  }
}
